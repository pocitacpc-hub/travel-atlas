{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generated",
    "dataAsOf",
    "mista"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generated": {
      "const": true
    },
    "dataAsOf": {
      "type": "string",
      "format": "date"
    },
    "mista": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nazev",
          "zeme",
          "oblast",
          "lat",
          "lon",
          "presnost"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "nazev": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "zeme": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "oblast": {
            "type": [
              "string",
              "null"
            ]
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "presnost": {
            "enum": [
              "obec",
              "oblast"
            ]
          }
        }
      }
    }
  }
}
