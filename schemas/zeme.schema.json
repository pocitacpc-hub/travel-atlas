{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "nazev",
      "iso",
      "vlajka"
    ],
    "properties": {
      "nazev": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "iso": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "vlajka": {
        "type": "string",
        "pattern": "^flags/4x3/[a-z]{2}\\.svg$"
      }
    }
  }
}
