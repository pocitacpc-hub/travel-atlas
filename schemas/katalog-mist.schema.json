{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "nazev",
      "zeme",
      "oblast",
      "lat",
      "lon",
      "presnost",
      "aliasy",
      "overeno"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "nazev": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "zeme": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "oblast": {
        "type": [
          "string",
          "null"
        ]
      },
      "lat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "lon": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "presnost": {
        "enum": [
          "obec",
          "oblast"
        ]
      },
      "aliasy": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "overeno": {
        "type": "boolean"
      }
    }
  }
}
